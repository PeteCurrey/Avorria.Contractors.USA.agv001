# ==============================================================================
# AVORRIA CONTRACTOR PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand Configuration Overrides (Optional)
NEXT_PUBLIC_BRAND_NAME=Avorria
NEXT_PUBLIC_DEFAULT_JURISDICTION=US

# Supabase Multi-Tenant Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analytics & Observability (Provider Agnostic)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Security & Secret Keys
CRON_SECRET=your-cron-secret-for-scheduled-tasks
