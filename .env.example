# ==============================================================================
# AVORRIA CONTRACTOR PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brand Configuration Overrides (Optional)
NEXT_PUBLIC_BRAND_NAME=Avorria
NEXT_PUBLIC_DEFAULT_JURISDICTION=US

# Supabase Multi-Tenant Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Analytics & Observability (Provider Agnostic)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Security & Secret Keys
CRON_SECRET=your-cron-secret-for-scheduled-tasks

# ─── AI Model Keys ─────────────────────────────────────────────────────────────
# Anthropic Claude (required for Ask Avorria + Photo Compliance Assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Firebase / Firestore (Ask Avorria & Photo Compliance data layer) ──────────
# Leave all three unset to use the local file-based adapter (.data/firestore/)
# Set all three to write directly to Google Cloud Firestore.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
